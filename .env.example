# Hardened Pegalead fork; actual supported settings only.
# Copy to .env.local and restrict permissions. Never reuse these blank secrets.
DATABASE_URL="mysql://wa_akg:FRESH_DB_PASSWORD@127.0.0.1:3306/wa_akg"
AUTH_SECRET=""
WA_AUTH_ENCRYPTION_KEY=""
BASE_URL="http://127.0.0.1:3030"
AUTH_URL="http://127.0.0.1:3030"
PORT="3030"
HOSTNAME="127.0.0.1"
NODE_ENV="production"
ENABLE_TELEMETRY="false"
# Pegalead owns campaign dispatch. Enable only for an independently managed gateway.
ENABLE_GATEWAY_SCHEDULER="false"
# Exact origins; permits private/HTTP webhooks only, never media/metadata requests.
WEBHOOK_ALLOWED_ORIGINS=""
BAILEYS_LOG_LEVEL="error"
TZ="America/Sao_Paulo"
NEXT_PUBLIC_APP_URL="http://127.0.0.1:3030"
NEXT_PUBLIC_API_URL="http://127.0.0.1:3030/api"
NEXT_PUBLIC_ALLOW_INDEXING="false"
NEXT_PUBLIC_CHAT_PAGE_SIZE="50"
# Bootstrap is explicit. Password is read from environment, never CLI arguments.
ADMIN_EMAIL="admin@example.invalid"
ADMIN_PASSWORD=""
# Compose only: dedicated application DB user and separate root password.
MYSQL_ROOT_PASSWORD=""
MYSQL_PASSWORD=""
MYSQL_DATABASE="wa_akg"
